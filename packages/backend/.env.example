# Copy to .env for local dev. `npm run infra:up` provisions matching services.
# CORS_ORIGIN is the Next app (packages/web) on :3000 — it must match the browser origin
# exactly or the httpOnly auth cookies are never sent and every request arrives anonymous.
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-only-change-me
# TOTP_ENCRYPTION_KEY seals staff authenticator-app secrets at rest. Leave unset in dev (a
# built-in development key is used). REQUIRED in production, at least 32 random characters,
# and long-lived: changing it invalidates every enrolled authenticator.
# PII_ENCRYPTION_KEY seals users' phone numbers and dates of birth at rest; PII_INDEX_KEY keys
# the blind index phone lookups match on. Leave both unset in dev. REQUIRED in production, at
# least 32 random characters each, and different from each other. PII_ENCRYPTION_KEY rotates
# (move the old value into PII_ENCRYPTION_KEYS_PREVIOUS, comma-separated); PII_INDEX_KEY does
# NOT — changing it makes every existing number unfindable.
# PII_ENCRYPTION_KEY=
# PII_ENCRYPTION_KEYS_PREVIOUS=
# PII_INDEX_KEY=
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://needy:needy@localhost:5432/needy
# DATABASE_MIGRATION_URL is the schema OWNER, used only for migrations and boot backfills.
# Unset in dev: one role does both, with a warning at boot. REQUIRED in production, as a
# DIFFERENT role from DATABASE_URL — boot refuses a runtime role that owns audit_log or can
# UPDATE/DELETE/TRUNCATE it. To try the split locally, create a login role (say needy_app),
# point DATABASE_URL at it and DATABASE_MIGRATION_URL at needy; the grants are made at boot.
# DATABASE_RUNTIME_ROLE names the runtime role for those grants; defaults to DATABASE_URL's user.
# DATABASE_MIGRATION_URL=
# DATABASE_RUNTIME_ROLE=

# Matching tuning (§2.4)
MATCH_RADIUS_METERS=10000
MATCH_OFFER_WINDOW_MS=50000

# Routing provider for real-road ETA (§2.3). Leave blank to fall back to a
# haversine estimate (clearly flagged in logs — straight-line ETA reads as fake).
DIRECTIONS_PROVIDER=
DIRECTIONS_API_KEY=

# ── Stage A · Identity & Verification ─────────────────────────────────────────
# Must be set explicitly. An UNSET NODE_ENV is treated as production: the dev-only token
# route and the fixed sign-in code are never enabled by forgetting a variable.
NODE_ENV=development
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
# Set true behind HTTPS in production (required for Secure cookies).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Provider selection. "console" logs OTPs (dev only); "sandbox" simulates eKYC.
# Swap to twilio / signzy|hyperverge|digilocker once credentials + adapters exist.
SMS_PROVIDER=console
KYC_PROVIDER=sandbox

# ── KYC document storage ──────────────────────────────────────────────────────
# "local" writes to a gitignored directory and signs URLs redeemed through this
# server. Production REFUSES to boot on local: KYC video on a container
# filesystem is lost on restart and unencrypted at rest.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=private-uploads
# This server's own public origin — the local adapter builds signed URLs against it.
PUBLIC_BASE_URL=http://localhost:4000
# How long an admin's document-view link stays valid. Minted on demand, so short.
STORAGE_SIGNED_URL_TTL_SECONDS=120
# Set STORAGE_DRIVER=s3 and these for a real private bucket (block public access,
# default SSE-KMS, a lifecycle rule matching your retention policy, and an
# AbortIncompleteMultipartUpload rule).
S3_BUCKET=
S3_REGION=ap-south-1
# Leave both empty on EC2/ECS: credentials then come from the instance or task role.
# Static keys are for a local MinIO or a host with no role, and warn in production.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
