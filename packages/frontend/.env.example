# Copy to .env.local to override. The tracking map defaults to OpenStreetMap tiles (no key).
# For production, point at a keyed provider (Mapbox / MapTiler) and set attribution.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
