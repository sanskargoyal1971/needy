# TLS termination for the production stack (docker-compose.prod.yml).
#
# Caddy obtains and renews certificates from Let's Encrypt by itself, so both names below must
# already resolve to this host before the stack starts. Two names, one registrable domain:
# the browser treats the app and the API as same-site, which is what lets the SameSite=Strict
# session cookies travel between them.

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	import security_headers
	# The backend's Prometheus endpoint is for the scraper on the compose network, never the
	# internet. Refused here so the bearer token is the SECOND lock, not the only one; a 404
	# rather than a 403 so a prober learns nothing. Caddy's path matcher is case-insensitive
	# and matches the decoded path, so /METRICS and /%6Detrics are refused too, and the
	# wildcard covers the trailing-slash form Express would also route. `respond` is ordered
	# before `reverse_proxy` by Caddy's directive order, so this wins.
	@metrics path /metrics /metrics/*
	respond @metrics 404
	# Socket.io upgrades to a WebSocket on this same name; reverse_proxy handles the upgrade.
	reverse_proxy backend:4000
}
